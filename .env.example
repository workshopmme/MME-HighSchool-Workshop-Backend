ADMIN_CODE=1234
# Use a long random value in production so signed admin sessions remain valid after restarts.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
# Initial ordering deadline only. Later changes are made in /admin/deadline/.
# An offset-free value is interpreted in Asia/Beirut; explicit offsets are converted.
ORDER_DEADLINE=2026-12-31T23:59:59+02:00
# Leave FRONTEND_ORIGIN out locally. On the server use https://YOUR-USERNAME.github.io
# FRONTEND_ORIGIN=http://localhost:5173
# DB_PATH=/var/lib/mme/mme.db

# Brevo transactional email (API key, not SMTP key).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=MME Lunch
# Public frontend URL, including any hosting subpath; no /admin suffix.
PUBLIC_SITE_URL=https://lunchmme.github.io/MME-Lunch
